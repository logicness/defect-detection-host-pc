/* ============================================================
   工业缺陷检测上位机 - 暗色主题 QSS（Fusion 风格）
   色板：背景 #0b0f17 / 卡片 #151b26 / 边框 #2a3441
         主蓝 #2563eb / 绿 #22c55e / 红 #ef4444 / 橙 #f59e0b
         正文 #cbd5e1 / 弱化 #64748b
   字号体系（对齐 Nano 参考版设计规范）：
         全局 16px / 卡片标题 18px / 按钮 16px / Tab 17px
         表格 16px / 状态栏 15px / 按钮 min-height 36px / 输入框 36px
   ============================================================ */

QWidget {
    background-color: #0b0f17;
    color: #cbd5e1;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 16px;
}

/* ---------- 卡片 ---------- */
QFrame#card {
    background-color: #151b26;
    border: 1px solid #2a3441;
    border-radius: 6px;
}
QLabel#cardTitle {
    color: #e2e8f0;
    font-size: 18px;
    font-weight: 600;
    background: transparent;
    border: none;
}

/* ---------- Tab 导航 ---------- */
QTabWidget::pane {
    border: none;
    background: #0b0f17;
}
QTabBar::tab {
    background: #10151f;
    color: #94a3b8;
    padding: 12px 28px;
    border: 1px solid #1f2937;
    border-bottom: none;
    font-size: 17px;
    min-width: 80px;
}
QTabBar::tab:selected {
    background: #151b26;
    color: #60a5fa;
    border-bottom: 2px solid #2563eb;
    font-weight: 600;
}
QTabBar::tab:hover:!selected { color: #cbd5e1; }

/* ---------- 按钮 ---------- */
QPushButton {
    background-color: #1e293b;
    color: #cbd5e1;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 9px 20px;
    min-height: 36px;
    min-width: 60px;
    font-size: 16px;
}
QPushButton:hover { background-color: #27364a; border-color: #475569; }
QPushButton:pressed { background-color: #1b2534; }
QPushButton:disabled { color: #475569; background-color: #16202e; border-color: #24303f; }

QPushButton#btnPrimary {
    background-color: #2563eb; color: #ffffff; border: 1px solid #2563eb;
    font-weight: 600;
}
QPushButton#btnPrimary:hover { background-color: #3b76f0; }

QPushButton#btnDanger {
    background-color: #b91c1c; color: #ffffff; border: 1px solid #b91c1c;
    font-weight: 600;
}
QPushButton#btnDanger:hover { background-color: #dc2626; }

/* 小按钮（工具栏/ROI/分页）：全局 padding 会吃掉小按钮内容区 */
QPushButton#iconBtn { padding: 0px 4px; font-size: 15px; min-height: 34px; min-width: 34px; }

/* 分段按钮（全部/OK/NG 等） */
QPushButton#segBtn { padding: 8px 22px; border-radius: 4px; }
QPushButton#segBtn:checked {
    background-color: #2563eb; color: #ffffff; border: 1px solid #2563eb;
}

/* ---------- 输入控件 ---------- */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    background-color: #0f172a;
    color: #e2e8f0;
    border: 1px solid #334155;
    border-radius: 4px;
    padding: 8px 12px;
    min-height: 38px;
    selection-background-color: #2563eb;
    font-size: 18px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus, QDateTimeEdit:focus {
    border-color: #2563eb;
}
QComboBox::drop-down { border: none; width: 22px; }
QComboBox QAbstractItemView {
    background-color: #0f172a; color: #e2e8f0;
    border: 1px solid #334155; selection-background-color: #1e3a8a;
}
QSpinBox::up-button, QDoubleSpinBox::up-button, QDateTimeEdit::up-button {
    subcontrol-origin: border; subcontrol-position: top right;
    width: 18px; border: none; background: #1e293b;
}
QSpinBox::down-button, QDoubleSpinBox::down-button, QDateTimeEdit::down-button {
    subcontrol-origin: border; subcontrol-position: bottom right;
    width: 18px; border: none; background: #1e293b;
}

/* ---------- 表格 ---------- */
QTableWidget {
    background-color: #10151f;
    alternate-background-color: #131a26;
    border: 1px solid #2a3441;
    gridline-color: #1f2937;
    selection-background-color: #1e3a8a;
    selection-color: #ffffff;
    font-size: 16px;
}
QTableWidget::item { padding: 8px 12px; }
QHeaderView::section {
    background-color: #1a2230;
    color: #94a3b8;
    border: none;
    border-bottom: 1px solid #2a3441;
    border-right: 1px solid #1f2937;
    padding: 9px 12px;
    font-weight: 600;
    font-size: 16px;
}
QTableWidget QTableCornerButton::section { background: #1a2230; border: none; }

/* ---------- 滚动条 ---------- */
QScrollBar:vertical {
    background: #10151f; width: 12px; border: none;
}
QScrollBar::handle:vertical {
    background: #334155; border-radius: 6px; min-height: 30px;
}
QScrollBar::handle:vertical:hover { background: #475569; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal {
    background: #10151f; height: 12px; border: none;
}
QScrollBar::handle:horizontal {
    background: #334155; border-radius: 6px; min-width: 30px;
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* ---------- 状态栏 ---------- */
QStatusBar {
    background: #10151f; color: #94a3b8;
    border-top: 1px solid #1f2937; font-size: 15px;
}
QStatusBar::item { border: none; }
QStatusBar QLabel { font-size: 15px; padding: 2px 6px; }

/* ---------- 进度条（系统状态） ---------- */
QProgressBar {
    background: #1e293b; border: none; border-radius: 3px;
    height: 10px; text-align: center; font-size: 0px;
}
QProgressBar::chunk { background: #22c55e; border-radius: 3px; }

/* ---------- 复选框 ---------- */
QCheckBox { spacing: 6px; background: transparent; font-size: 16px; }
QCheckBox::indicator {
    width: 16px; height: 16px; border: 1px solid #334155;
    border-radius: 3px; background: #0f172a;
}
QCheckBox::indicator:checked { background: #2563eb; border-color: #2563eb; }

/* ---------- 分组/工具提示 ---------- */
QGroupBox {
    border: 1px solid #2a3441; border-radius: 4px;
    margin-top: 10px; padding-top: 8px;
    color: #94a3b8; font-weight: 600; font-size: 16px;
}
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }

QToolTip {
    background: #1e293b; color: #e2e8f0; border: 1px solid #334155; padding: 6px;
    font-size: 14px;
}

/* ---------- 滑块 ---------- */
QSlider::groove:horizontal {
    border: none; height: 4px;
    background-color: #334155; border-radius: 2px;
}
QSlider::handle:horizontal {
    background-color: #2563eb; border: none;
    width: 14px; height: 14px; margin: -5px 0; border-radius: 7px;
}
QSlider::handle:horizontal:hover { background-color: #1d4ed8; }
